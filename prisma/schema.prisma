// aifanyi.com 数据模型 v0.2 - 统一用户账户体系
// 设计原则：业务表与语料库分离；所有翻译行为都可回溯（成本/模型/原文哈希）
// User/Auth/Usage/Translation Job 解耦；所有额度配置化

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════ 用户账户 ═══════════════════
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  nickname      String?
  avatar        String?
  authProvider  String?
  status        String    @default("active")
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  identities                 AuthIdentity[]
  sessions                   Session[]
  usageLedgers               UsageLedger[]
  translationJobs            PdfJob[]                    @relation("UserPdfJobs")
  documentProgress           DocumentProgress[]
  votes                      Vote[]
  corrections                Correction[]
  glossaries                 Glossary[]
  creditAccount              CreditAccount?
  creditLedgers              CreditLedger[]
  creditGrants               CreditGrant[]
  usageRecords               UsageRecord[]
  ecommerceProjects          EcommerceProject[]
  ecommerceProducts          EcommerceProduct[]
  ecommerceListings          EcommerceListing[]
  ecommerceListingRuns       EcommerceListingRun[]
  ecommerceAssets            EcommerceAsset[]
  ecommerceAssetTranslations EcommerceAssetTranslation[]
  ecommerceCustomerMessages  EcommerceCustomerMessage[]
  ecommerceJobs              EcommerceJob[]

  @@index([email])
  @@index([status])
}

// ═══════════════════ 认证会话 ═══════════════════
model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique
  userId        String
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  ipHash        String?
  userAgentHash String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

// ═══════════════════ OTP 验证码 ═══════════════════
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  tokenHash  String
  expiresAt  DateTime
  used       Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier])
}

// ═══════════════════ 盲测擂台 ═══════════════════
model Blindtest {
  id           String   @id @default(cuid())
  sourceText   String
  sourceLang   String   @default("zh")
  targetLang   String   @default("en")
  translations Json
  winnerModel  String?
  voteCount    Int      @default(0)
  status       String   @default("published")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  votes Vote[]
}

model Vote {
  id          String   @id @default(cuid())
  blindtestId String
  model       String
  ipHash      String?
  createdAt   DateTime @default(now())

  blindtest Blindtest @relation(fields: [blindtestId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?

  @@index([blindtestId])
  @@index([ipHash])
}

// ═══════════════════ 梗翻译 ═══════════════════
model MemeEntry {
  id          String   @id @default(cuid())
  term        String   @unique
  slug        String   @unique
  lang        String   @default("zh-CN")
  meaning     String
  translation String
  examples    Json
  tags        String[]
  popularity  Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═══════════════════ 文本翻译任务 ═══════════════════
model TranslationJob {
  id                 String   @id @default(cuid())
  sourceHash         String
  sourceText         String
  sourceLang         String
  targetLang         String
  scenario           String   @default("general")
  style              String?
  model              String
  resultText         String
  promptTokens       Int      @default(0)
  completionTokens   Int      @default(0)
  costUsd            Float    @default(0)
  latencyMs          Int      @default(0)
  cached             Boolean  @default(false)
  qualityScore       Float?
  creditState        String?
  reservedCredits    Int      @default(0)
  consumedCredits    Int      @default(0)
  pricingRuleVersion Int      @default(1)
  createdAt          DateTime @default(now())

  @@index([sourceHash])
  @@index([model])
  @@index([createdAt])
}

// ═══════════════════ 语料库 ═══════════════════
model CorpusEntry {
  id         String   @id @default(cuid())
  sourceText String
  targetText String
  sourceLang String
  targetLang String
  scenario   String
  quality    Int      @default(3)
  votes      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([scenario])
  @@index([sourceLang, targetLang])
}

model Correction {
  id         String   @id @default(cuid())
  sourceText String
  badText    String
  goodText   String
  sourceLang String   @default("zh")
  targetLang String   @default("en")
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([status])
}

// ═══════════════════ 术语库 ═══════════════════
model TermbaseEntry {
  id        String   @id @default(cuid())
  domain    String
  termZh    String
  termEn    String
  note      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([domain, termZh])
}

model Glossary {
  id        String   @id @default(cuid())
  termZh    String
  termEn    String
  locked    Boolean  @default(true)
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([userId])
}

// ═══════════════════ PDF 翻译任务 ═══════════════════
model PdfJob {
  id                 String    @id @default(cuid())
  taskId             String    @unique
  fileName           String
  fileSize           Int
  pageCount          Int
  sourceLang         String    @default("auto")
  targetLang         String    @default("zh")
  status             String    @default("queued")
  progress           Int       @default(0)
  currentPage        Int       @default(0)
  totalBlocks        Int       @default(0)
  translatedBlocks   Int       @default(0)
  errorType          String?
  errorMessage       String?
  limitations        Json?
  document           Json?
  totalInputTokens   Int       @default(0)
  totalOutputTokens  Int       @default(0)
  totalCostUsd       Float     @default(0)
  apiErrorCount      Int       @default(0)
  compareCount       Int       @default(0)
  durationMs         Int?
  clientKey          String?
  userId             String?
  guestSessionId     String?
  expiresAt          DateTime?
  saved              Boolean   @default(false)
  creditState        String?
  reservedCredits    Int       @default(0)
  consumedCredits    Int       @default(0)
  pricingRuleVersion Int       @default(1)
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  user User? @relation("UserPdfJobs", fields: [userId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([clientKey])
  @@index([userId])
  @@index([guestSessionId])
  @@index([userId, createdAt])
}

// ═══════════════════ 字幕翻译任务 ═══════════════════
model SubtitleJob {
  id                 String    @id @default(cuid())
  taskId             String    @unique
  fileName           String
  fileSize           Int
  status             String    @default("queued")
  progress           Int       @default(0)
  totalCues          Int       @default(0)
  translatedCues     Int       @default(0)
  sourceLang         String    @default("auto")
  targetLang         String    @default("zh")
  errorType          String?
  errorMessage       String?
  document           Json? // { cues: [{ index, start, end, text, translation? }] }
  totalInputTokens   Int       @default(0)
  totalOutputTokens  Int       @default(0)
  totalCostUsd       Float     @default(0)
  apiErrorCount      Int       @default(0)
  durationMs         Int?
  clientKey          String?
  userId             String?
  guestSessionId     String?
  creditState        String?
  reservedCredits    Int       @default(0)
  consumedCredits    Int       @default(0)
  pricingRuleVersion Int       @default(1)
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([guestSessionId])
  @@index([createdAt])
}

// ═══════════════════ PDF 埋点 ═══════════════════
model PdfEvent {
  id             String   @id @default(cuid())
  event          String
  taskId         String?
  pageCount      Int?
  sourceLang     String?
  targetLang     String?
  durationMs     Int?
  costUsd        Float?
  model          String?
  userId         String?
  guestSessionId String?
  createdAt      DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([userId])
  @@index([guestSessionId])
}

// ═══════════════════ 额度账本 ═══════════════════
model UsageLedger {
  id             String   @id @default(cuid())
  userId         String?
  guestSessionId String?
  type           String
  amount         Int
  unit           String
  taskId         String?
  description    String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([guestSessionId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ═══════════════════ 阅读进度 ═══════════════════
model DocumentProgress {
  id          String   @id @default(cuid())
  userId      String
  documentId  String
  lastPage    Int
  lastBlockId String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId, documentId])
}

// ═══════════════════ 积分账户 ═══════════════════
model CreditAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  balance         Int      @default(0) // 可用额度（性能缓存，唯一事实来源 = CreditLedger）
  reservedBalance Int      @default(0) // 已预留未结算
  version         Int      @default(0) // 乐观锁
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id             String   @id @default(cuid())
  userId         String
  type           String // reserve | consume | release | refund | grant | expire | admin_adjust
  amount         Int // 正=增加可用，负=减少可用
  grantId        String?
  usageId        String?
  jobId          String?
  referenceId    String?
  idempotencyKey String   @unique // 幂等：jobId:op[:seq]，重复插入即冲突
  description    String?
  metadata       Json?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([jobId])
}

// ═══════════════════ 认证身份（多 Provider） ═══════════════════
// Phase 1 新增：User 与登录方式解耦；未来 Apple/微信/邮箱 直接加 provider
model AuthIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String // google | email | apple | wechat | ...
  providerAccountId String // Google sub / 邮箱 / Apple sub
  providerEmail     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ═══════════════════ Credit 额度批次 ═══════════════════
model CreditGrant {
  id              String    @id @default(cuid())
  userId          String
  type            String // FREE_MONTHLY | FREE_GRANT | BONUS | SUBSCRIPTION | PURCHASED | ADMIN_ADJUSTMENT | REFUND
  source          String // 注册赠送 | 免费额度 | Pro月度 | 购买 | 活动 | 客服补偿 | 退款
  totalAmount     Int
  remainingAmount Int
  reservedAmount  Int       @default(0)
  expiresAt       DateTime? // null = 永久
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, type])
}

// ═══════════════════ Usage 使用记录 ═══════════════════
model UsageRecord {
  id                 String    @id @default(cuid())
  userId             String?
  guestSessionId     String?
  feature            String // text_translation | pdf_translation | image_translation | subtitle_translation | doc_translation | web_translation | polish | blindtest
  jobId              String?
  documentId         String?
  inputCharacters    Int       @default(0)
  inputTokens        Int       @default(0)
  outputTokens       Int       @default(0)
  provider           String?
  model              String?
  pageCount          Int?
  imageCount         Int?
  durationSeconds    Int?
  segmentCount       Int?
  paragraphCount     Int?
  estimatedCredits   Int       @default(0)
  reservedCredits    Int       @default(0)
  consumedCredits    Int       @default(0)
  releasedCredits    Int       @default(0)
  refundedCredits    Int       @default(0)
  status             String    @default("reserved") // reserved|consumed|released|refunded|partial
  costUsd            Float     @default(0)
  pricingRuleVersion Int       @default(1)
  appliedUnitPrice   Int?
  metadata           Json?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([jobId])
}

// ═══════════════════ Pricing 定价规则 ═══════════════════
model PricingRule {
  id          String   @id @default(cuid())
  feature     String // text_translation | pdf_translation | ...
  unit        String // per_1000_chars | per_page | per_image | per_minute | per_file | per_segment
  creditRate  Int // 每 unit 多少 credit
  minCharge   Int      @default(1)
  maxCharge   Int?
  version     Int      @default(1)
  active      Boolean  @default(true)
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([feature, version])
}

// ═══════════════════ Reconciliation 对账记录 ═══════════════════
model ReconciliationRecord {
  id         String    @id @default(cuid())
  checkType  String // account_vs_ledger | grants_vs_account | stuck_reserve
  userId     String?
  expected   Int?
  actual     Int?
  diff       Int?
  detail     String?
  status     String    @default("open") // open | resolved
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

// ═══════════════════ 跨境电商工作台（V1） ═══════════════════
// Product-first UX：Project 仅作 DB 归属（默认「默认项目」）；Product 是用户操作主体
// 所有用户数据表带 userId（IDOR 防护）；Product/Asset 通过 Project 归属校验

model EcommerceProject {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("默认项目")
  description String?
  status      String   @default("active") // active | archived | deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products EcommerceProduct[]
  assets   EcommerceAsset[]
  messages EcommerceCustomerMessage[]
  jobs     EcommerceJob[]

  @@index([userId])
}

model EcommerceProduct {
  id                String    @id @default(cuid())
  projectId         String
  userId            String
  productName       String
  sourceDescription String?
  category          String?
  brand             String?
  sku               String?
  features          Json? // 卖点（string[]）
  specifications    Json? // 规格（string[]）
  materials         Json? // 材质（string[]）
  dimensions        Json? // 尺寸（{length,width,height,unit}）
  weight            String?
  targetMarket      String?
  platform          String?
  sourceLang        String    @default("zh")
  status            String    @default("active") // active | deleted
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project  EcommerceProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings EcommerceListing[]
  runs     EcommerceListingRun[]
  assets   EcommerceAsset[]
  messages EcommerceCustomerMessage[]

  @@index([userId])
  @@index([projectId])
  @@index([userId, createdAt])
}

// Listing = 商品在某平台/市场/语言下的销售内容（一个版本 = 一份完整 Draft）
model EcommerceListing {
  id              String   @id @default(cuid())
  productId       String
  userId          String
  version         Int      @default(1)
  draft           Json // { title, bulletPoints[], description, keywords[], faqHighlights[] }
  pendingEdit     Json? // 待应用的 AI 微调结果 { field, instruction, content, changes, warnings, factConflicts, platformIssues, createdAt }
  status          String   @default("current") // current | history
  charCount       Int      @default(0)
  warnings        Json? // Fact Validation 待确认项（string[]）
  creditState     String?
  consumedCredits Int      @default(0)
  metadata        Json? // { platform, market, language, model }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product EcommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, version])
  @@index([userId])
  @@index([productId, status])
}

// 一次生成任务（含 Fact Validation + 幂等）
model EcommerceListingRun {
  id             String   @id @default(cuid())
  productId      String
  userId         String
  platform       String?
  market         String?
  language       String?
  inputSnapshot  Json? // 生成时输入快照（AI 提取后的商品资料）
  output         Json? // 生成结果（完整 draft）
  warnings       Json? // Fact Validation warnings
  status         String   @default("pending") // pending | success | failed
  errorType      String?
  errorMessage   String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product EcommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
}

// 素材（经 StorageService 落盘/对象存储；soft delete）
model EcommerceAsset {
  id           String    @id @default(cuid())
  projectId    String
  productId    String?
  userId       String
  type         String // image | csv | other
  mime         String
  size         Int
  storageKey   String
  originalName String?
  status       String    @default("active") // active | deleted
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project      EcommerceProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product      EcommerceProduct?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  translations EcommerceAssetTranslation[]

  @@index([userId])
  @@index([projectId])
  @@index([productId])
}

model EcommerceAssetTranslation {
  id              String   @id @default(cuid())
  assetId         String
  userId          String
  targetLang      String
  ocrText         Json? // OCR 识别结果（string[]）
  translated      Json? // 翻译结果（string[]）
  layout          Json? // 布局重建结果
  status          String   @default("pending") // pending | success | failed
  creditState     String?
  reservedCredits Int      @default(0)
  consumedCredits Int      @default(0)
  errorType       String?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset EcommerceAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([userId])
}

// 客户消息（productId 可空：既可挂 Project 也可挂具体 Product）
model EcommerceCustomerMessage {
  id          String   @id @default(cuid())
  projectId   String
  productId   String?
  userId      String
  sourceText  String
  sourceLang  String   @default("auto")
  translation String?
  intent      String?
  replyJson   Json? // { reply, tone }
  tone        String? // professional | friendly | concise
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project EcommerceProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product EcommerceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([productId])
}

// 通用异步任务（图片翻译等）
model EcommerceJob {
  id              String    @id @default(cuid())
  taskId          String    @unique
  userId          String
  projectId       String?
  kind            String // asset_translation | ...
  status          String    @default("pending") // pending | running | completed | failed | cancelled
  progress        Int       @default(0)
  payload         Json?
  result          Json?
  errorType       String?
  errorMessage    String?
  creditState     String?
  reservedCredits Int       @default(0)
  consumedCredits Int       @default(0)
  idempotencyKey  String    @unique
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project EcommerceProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// 平台规则（长度/字段/格式）
model EcommercePlatformRule {
  id                String   @id @default(cuid())
  platform          String // amazon_us | amazon_uk | ...
  market            String // us | uk | ...
  field             String // title | bullet_points | description | keywords
  minLength         Int?
  maxLength         Int?
  recommendedLength Int?
  rules             Json? // 平台格式规则
  version           Int      @default(1)
  active            Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@unique([platform, market, field, version])
  @@index([platform, market])
}

// 合规规则（禁虚构/敏感声明/未验证功效）
model EcommerceContentCompliance {
  id        String   @id @default(cuid())
  platform  String
  market    String?
  category  String?
  ruleType  String // no_fabrication | no_sensitive_claim | no_unverified_efficacy
  ruleText  Json // { zh, en? }
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform, market])
}

model AdminLog {
  id        String   @id @default(cuid())
  operator  String
  action    String
  targetId  String?
  batchId   String?
  params    Json?
  result    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@unique([action, batchId])
  @@index([operator, createdAt])
}

model GuestUsage {
  id        Int      @id @default(autoincrement())
  ipHash    String   @db.VarChar(64)
  date      String   @db.VarChar(10)
  count     Int      @default(0)
  chars     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([ipHash, date])
  @@index([date])
}

model VoiceRateUsage {
  id        Int      @id @default(autoincrement())
  userId    String   @db.VarChar(64)
  minuteKey String   @db.VarChar(12)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, minuteKey])
  @@index([minuteKey])
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(32)
  message   String   @db.VarChar(2000)
  stack     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PricePlan {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  priceCents       Int
  totalCredits     Int
  purchasedCredits Int
  bonusCredits     Int
  bonusTtlDays     Int      @default(30)
  badge            String?
  description      String?
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([active, sortOrder])
}

model RechargeOrder {
  id               String    @id @default(cuid())
  userId           String
  planCode         String
  planName         String
  priceCents       Int
  purchasedCredits Int
  bonusCredits     Int
  status           String    @default("pending")
  provider         String?
  providerOrderId  String?   @unique
  idempotencyKey   String    @unique
  createdAt        DateTime  @default(now())
  paidAt           DateTime?
  grantedAt        DateTime?
  expiresAt        DateTime?
  checkoutUrl      String?

  @@index([userId, createdAt])
  @@index([status])
}

// ===== 语言与世界 · 词条类（/idioms /untranslatable + 未来 /slang /expressions /food）=====
model ExpressionEntry {
  id          String   @id @default(cuid())
  term        String
  slug        String   @unique
  type        String   @default("idiom") // idiom|slang|untranslatable|food|expression
  lang        String   @default("zh-CN")
  meaning     String
  translation String
  pinyin      String?
  literal     String?
  example     String?
  usage       String?
  note        String?
  source      String?
  culture     String?
  multiLang   Json?
  tags        String[]
  popularity  Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([lang])
  @@index([status])
}

// ===== 场景类（/travel/{country}/{scene} · /life/{country}/{scene}）=====
model SceneEntry {
  id         String   @id @default(cuid())
  slug       String   @unique
  country    String
  language   String
  scene      String
  kind       String   @default("travel") // travel|life
  title      String
  intro      String
  phrases    Json // [{native, zh, pronounce, polite}]
  tips       Json?
  related    Json?
  popularity Int      @default(0)
  status     String   @default("published")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([country, scene])
  @@index([kind])
}

// ===== 菜单词典（/menu/{country}/{dish}）=====
model MenuEntry {
  id          String   @id @default(cuid())
  slug        String   @unique
  country     String
  language    String
  dish        String
  romaji      String?
  zh          String
  en          String?
  description String?
  category    String?
  pairings    Json?
  tags        String[]
  popularity  Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([country])
  @@index([category])
  @@index([status])
}

// ===== 菜谱（/recipes/{dish}）=====
model RecipeEntry {
  id            String   @id @default(cuid())
  slug          String   @unique
  dish          String
  originalName  String?
  zhName        String
  enName        String?
  intro         String?
  ingredients   Json
  steps         Json
  cookTime      String?
  difficulty    String?
  vocab         Json?
  misTranslated Json?
  culture       String?
  popularity    Int      @default(0)
  status        String   @default("published")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}
