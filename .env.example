# ===== aifanyi.com 环境变量模板 =====
# 复制为 .env 并填入真实值；.env 已被 gitignore，不会入库

# PostgreSQL 连接串（开发期可用本地 Docker / Neon 免费层）
DATABASE_URL="postgresql://postgres:***@localhost:5432/aifanyi"

# ---- 模型 API Key ----
DEEPSEEK_API_KEY=""
GLM_API_KEY=""
GOOGLE_TRANSLATE_API_KEY=""   # Google Cloud Translation（取代 DeepL）

# ---- 预留（暂不启用）----
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ---- 成本控制 ----
# 月度模型预算上限（元），超限后自动降级 GLM 免费档
MODEL_BUDGET_MONTHLY_CNY="1000"

# ---- 部署 ----
NEXT_PUBLIC_SITE_URL="https://aifanyi.com"
